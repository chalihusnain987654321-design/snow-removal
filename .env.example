# Copy to .env.local and fill in real values. Nothing here is required
# for the site to build or run — each integration no-ops until its
# variable is set.

# Resend (https://resend.com) — required for the quote form to actually
# send email. Without it, /api/quote returns a clear error and the
# request lands on /quote-error/.
RESEND_API_KEY=

# Google Tag Manager container ID is a plain constant in
# config/analytics.ts, not an env var — see that file. GA4 and any
# other tags are configured inside the GTM container itself.

# Google Search Console HTML tag verification code (the content value
# of the meta tag GSC gives you, not the whole tag).
GOOGLE_SITE_VERIFICATION=
